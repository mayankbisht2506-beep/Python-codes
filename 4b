# Plotting Residuals
plt.figure(figsize=(10, 6))
mu_lcdm_best = np.array([get_distance_modulus(z, res_lcdm.x[0], res_lcdm.x[1], 'lcdm') for z in z_data])
mu_vac_best = np.array([get_distance_modulus(z, 67.4, 0.315, 'vacuum') for z in z_data]) + res_vac.x[0]

# Bin for clarity
df['resid_lcdm'] = mu_data - mu_lcdm_best
df['resid_vac'] = mu_data - mu_vac_best
df['z_bin'] = pd.cut(df['zHD'], bins=np.logspace(np.log10(0.01), np.log10(2.3), 20))
binned = df.groupby('z_bin').mean(numeric_only=True)
z_bin_centers = [i.mid for i in binned.index]

plt.axhline(0, color='black', ls='-', lw=1)
plt.errorbar(z_bin_centers, binned['resid_lcdm'], fmt='o', label='Optimized LCDM Residuals', alpha=0.7)
plt.errorbar(z_bin_centers, binned['resid_vac'], fmt='x', color='red', label='Vacuum Model Residuals', alpha=0.7)

plt.xlabel('Redshift z')
plt.ylabel('Residual Mag (Data - Model)')
plt.title('Shape Consistency: Vacuum vs. Optimized LCDM')
plt.legend()
plt.xscale('log')
plt.grid(True, alpha=0.3)
plt.show()

# ==========================================
delta_chi2 = best_vac_chi2 - best_lcdm_chi2

print("\n" + "="*50)
print("METRIC 2: SHAPE CONSISTENCY RESULTS")
print("="*50)
print(f"{'Model':<20} | {'Chi2':<10} | {'DoF'}")
print("-" * 50)
print(f"{'Optimized LCDM':<20} | {best_lcdm_chi2:<10.2f} | 2 (H0, Om)")
print(f"{'Vacuum (Theory)':<20} | {best_vac_chi2:<10.2f} | 0 (Fixed Physics)")

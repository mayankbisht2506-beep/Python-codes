import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import requests
import io
from scipy.integrate import quad
from scipy.optimize import minimize

print("--- PANTHEON+ SHAPE CONSISTENCY TEST (METRIC 2) ---")
print("Objective: Verify that Vacuum Model fits the expansion SHAPE as well as optimized LCDM.")

# ==========================================
# 1. PHYSICS ENGINE
# ==========================================
C_LIGHT = 299792.458
OM_PLANCK = 0.315
OL_PLANCK = 1.0 - OM_PLANCK

# Vacuum Model Parameters (Fixed by Geometry)
Z_TRANS = 0.65
WIDTH = 0.1
# Transition Amplitude (Derived from H0 shift 67.4 -> 73.74)
# Amp = H_late / H_early approx 1.09
AMP_VAC = 73.74 / 67.4 

def get_hubble_lcdm(z, h0, om):
    """Standard LCDM Expansion Rate"""
    ol = 1.0 - om
    E = np.sqrt(om * (1 + z)**3 + ol)
    return h0 * E

def get_hubble_vacuum(z, h0_base, om):
    """
    Vacuum Elastodynamics Expansion Rate
    Transitions from H_base (early) to H_base * AMP (late)
    """
    # Standard evolution
    ol = 1.0 - om
    E = np.sqrt(om * (1 + z)**3 + ol)
    
    # Vacuum Phase Transition (Sigmoid)
    # Early Universe (z >> 0.65): sigmoid -> 0, Factor -> 1.0 (Planck-like)
    # Late Universe (z << 0.65): sigmoid -> 1, Factor -> AMP (SH0ES-like)
    sigmoid = 1.0 / (1.0 + np.exp(-(z - Z_TRANS) / WIDTH))
    # Note: Transition logic inverted relative to stiffness. 
    # High Stiffness (Late) = High H0. 
    # Low Stiffness (Early) = Low H0.
    # The 'amp' factor applies to the Late Universe relative to the Planck baseline.
    transition_factor = 1.0 + (AMP_VAC - 1.0) * (1.0 - sigmoid) # Wait, check logic.
    
    # Let's align with Paper Section 7.1 eq 74:
    # G(z) relaxes. H(z) boosts at late times.
    # If H0_base = 67.4 (Planck), we want H(z=0) ~ 73.7.
    # So factor should be active at z=0.
    # Sigmoid(0) = 1/(1+exp(6.5)) ~ 0.0015 (Low).
    # Sigmoid(high_z) ~ 1.
    # We want boost at Low z.
    vacuum_boost = 1.0 + (AMP_VAC - 1.0) * (1.0 - sigmoid) 
    
    return h0_base * E * vacuum_boost

def get_distance_modulus(z, h0, om, model='lcdm'):
    """Calculates mu(z) for a given model"""
    if z <= 0: return np.nan
    
    if model == 'lcdm':
        integrand = lambda zp: 1.0 / get_hubble_lcdm(zp, h0, om)
    else:
        integrand = lambda zp: 1.0 / get_hubble_vacuum(zp, h0, om)
        
    # Integrate comoving distance
    r_c, _ = quad(integrand, 0, z)
    
    # Convert to Luminosity Distance
    d_L = (1 + z) * C_LIGHT * r_c
    
    return 5 * np.log10(d_L) + 25

# ==========================================
# 2. DATA LOADING
# ==========================================
url = "https://raw.githubusercontent.com/PantheonPlusSH0ES/DataRelease/main/Pantheon%2B_Data/4_DISTANCES_AND_COVAR/Pantheon%2BSH0ES.dat"
print("Downloading Pantheon+ Data...")
df = pd.read_csv(io.StringIO(requests.get(url).text), sep=r'\s+')
df = df[df['zHD'] > 0.01].copy() # Cut very low z to avoid pec vel noise

# We use the provided distance modulus and errors
z_data = df['zHD'].values
mu_data = df['MU_SH0ES'].values
err_data = df['MU_SH0ES_ERR_DIAG'].values

# ==========================================
# 3. OPTIMIZATION (THE STEEL MAN TEST)
# ==========================================
print("Running Shape Optimization (Fair Comparison)...")

# --- Model A: Optimized LCDM (Standard) ---
# Free Parameters: H0, Om
def chi2_lcdm(params):
    h0_try, om_try = params
    mu_model = np.array([get_distance_modulus(z, h0_try, om_try, 'lcdm') for z in z_data])
    return np.sum(((mu_data - mu_model) / err_data)**2)

res_lcdm = minimize(chi2_lcdm, [73.0, 0.315], bounds=[(60, 80), (0.2, 0.4)])
best_lcdm_chi2 = res_lcdm.fun
print(f"Optimized LCDM (H0={res_lcdm.x[0]:.2f}, Om={res_lcdm.x[1]:.3f}): Chi2 = {best_lcdm_chi2:.2f}")

# --- Model B: Vacuum Elastodynamics ---
# Free Parameters: Nuisance M, Om (Allowing Om to float makes it a fair shape test)
# Fixed Parameters: Base H0 (67.4), Transition Physics (z=0.65)

def chi2_vacuum(params):
    m_shift, om_try = params  # NOW OPTIMIZING Om TOO
    # H0 is fixed to Planck (67.4), but the shape (Om) is allowed to fit the data
    mu_model = np.array([get_distance_modulus(z, 67.4, om_try, 'vacuum') for z in z_data])
    return np.sum(((mu_data - (mu_model + m_shift)) / err_data)**2)

# Optimization with bounds for M_shift and Om
res_vac = minimize(chi2_vacuum, [0.0, 0.315], bounds=[(-0.5, 0.5), (0.2, 0.4)])
best_vac_chi2 = res_vac.fun
print(f"Vacuum Model   (M_shift={res_vac.x[0]:.3f}, Om={res_vac.x[1]:.3f}): Chi2 = {best_vac_chi2:.2f}")

# ==========================================
# 4. RESULTS
# ==========================================
delta_chi2 = best_vac_chi2 - best_lcdm_chi2

print("\n" + "="*50)
print("METRIC 2: SHAPE CONSISTENCY RESULTS (CORRECTED)")
print("="*50)
print(f"{'Model':<20} | {'Chi2':<10} | {'DoF'}")
print("-" * 50)
print(f"{'Optimized LCDM':<20} | {best_lcdm_chi2:<10.2f} | 2 (H0, Om)")
print(f"{'Vacuum (Theory)':<20} | {best_vac_chi2:<10.2f} | 2 (M, Om)")
print("-" * 50)
print(f"Delta Chi2: {delta_chi2:.2f}")

if abs(delta_chi2) < 2.0:
    print("VERDICT: PASS. Vacuum Model is statistically indistinguishable from Optimized LCDM.")
    print("The phase transition shape (z~0.65) fits the data naturally.")
else:
    print("VERDICT: FAIL. Significant shape distortion detected.")

